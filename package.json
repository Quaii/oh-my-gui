{
  "name": "omp-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "server",
    "web"
  ],
  "scripts": {
    "dev": "concurrently -n server,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "node --watch server/src/index.ts",
    "dev:web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "node server/src/index.ts",
    "serve": "npm run build && npm start",
    "test": "node --test server/tests/*.test.ts",
    "typecheck": "tsc --noEmit",
    "docs:check": "node scripts/check-agent-docs.mjs",
    "desktop:dev": "tauri dev",
    "desktop:build": "node scripts/build-desktop.mjs",
    "desktop:prepare": "node scripts/prepare-desktop.mjs",
    "desktop:check": "node scripts/check-desktop.mjs",
    "desktop:release-check": "node scripts/desktop-release-check.mjs",
    "desktop:installer": "node scripts/build-desktop-installer.mjs",
    "desktop:icons": "node scripts/generate-desktop-icons.mjs"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.6",
    "@tauri-apps/cli": "^2.12.4",
    "@types/flubber": "^0.4.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.0.6",
    "typescript": "^5.7.3",
    "vite": "^6.1.0"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "figma-squircle": "^1.1.0",
    "flubber": "^0.4.2",
    "lucide-react": "^1.73.0",
    "marked": "^18.2.0",
    "motion": "^14.14.0",
    "prism-react-renderer": "^2.4.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-use-measure": "^2.1.7",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "yaml": "^2.7.0"
  },
  "overrides": {
    "vgpu": {
      "@modelcontextprotocol/server": "2.4.0"
    }
  }
}
